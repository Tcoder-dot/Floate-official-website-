{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents the merchant profile and account parameters.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Full display name of the merchant."
        },
        "email": {
          "type": "string",
          "description": "Primary communication and login email."
        },
        "credits": {
          "type": "number",
          "description": "Active chasing wallet balance in Naira."
        },
        "subscriptionTier": {
          "type": "string",
          "enum": ["FREE", "HUSTLER", "MERCHANT"],
          "description": "Active subscription plan of the merchant."
        },
        "escrowBalance": {
          "type": "number",
          "description": "Cleared escrow funds available for withdrawal."
        },
        "isBlacklisted": {
          "type": "boolean",
          "description": "Security flag preventing system actions."
        },
        "phone": {
          "type": "string",
          "description": "Merchant phone number for text alert synchronization."
        },
        "realName": {
          "type": "string",
          "description": "Verified legal full name of the merchant."
        },
        "businessName": {
          "type": "string",
          "description": "SME operational trade name."
        },
        "businessCategory": {
          "type": "string",
          "description": "Commercial industry segment of the SME business."
        },
        "cacNumber": {
          "type": "string",
          "description": "Corporate Affairs Commission official legal registration number."
        },
        "businessAddress": {
          "type": "string",
          "description": "Physical registered office address of the business."
        },
        "onboardingCompleted": {
          "type": "boolean",
          "description": "Whether the merchant has finished the compliance onboarding process."
        },
        "creditScore": {
          "type": "number",
          "description": "Merchant credit risk rating out of 1000 computed from performance trackers."
        },
        "location": {
          "type": "string",
          "description": "Operational country or state location of the merchant."
        },
        "profession": {
          "type": "string",
          "description": "Professional occupation or primary focus of the merchant."
        },
        "referralSource": {
          "type": "string",
          "description": "Referral channel indicating where they found the application."
        },
        "paymentChallenge": {
          "type": "string",
          "description": "Primary pain point when collecting payments from clients."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the merchant account was created."
        }
      },
      "required": ["name", "email", "credits", "subscriptionTier", "escrowBalance"]
    },
    "Debtor": {
      "title": "Debtor",
      "description": "Outstanding payment folder for a specific debtor client.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Auth UID of the owning merchant."
        },
        "name": {
          "type": "string",
          "description": "Name of the debtor client."
        },
        "email": {
          "type": "string",
          "description": "Email address of the debtor."
        },
        "phone": {
          "type": "string",
          "description": "Telecom/SMS line of the debtor."
        },
        "amount": {
          "type": "number",
          "description": "Outstanding arrear amount."
        },
        "currency": {
          "type": "string",
          "description": "Currency of the trade (e.g. ₦)."
        },
        "receiptName": {
          "type": "string",
          "description": "Name of OCR doc waybill or handshake designation."
        },
        "receiptUrl": {
          "type": "string",
          "description": "Reference URL or placeholder for the uploaded invoice."
        },
        "remindStyle": {
          "type": "string",
          "enum": ["GENTLE", "AGGRESSIVE"],
          "description": "Outreach style selected."
        },
        "status": {
          "type": "string",
          "enum": ["DRAFT", "ACTIVE", "PAID"],
          "description": "Current tracking status."
        },
        "remindersCount": {
          "type": "number",
          "description": "Number of dispatched reminder outreach attempts."
        },
        "lastRemindedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the last reminder campaign."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the debt file was opened."
        },
        "merchantBusinessName": {
          "type": "string",
          "description": "SME Business name associated with this transaction."
        },
        "merchantLocation": {
          "type": "string",
          "description": "Physical operational location of the merchant."
        },
        "merchantEthnicity": {
          "type": "string",
          "description": "SME's local cultural dialect/demographics category."
        },
        "merchantWhatTheySell": {
          "type": "string",
          "description": "Commercial catalog item context."
        },
        "debtorLocation": {
          "type": "string",
          "description": "Operational residence/location of debtor."
        },
        "paymentDueDate": {
          "type": "string",
          "description": "Formulated or extracted raw payment deadline."
        },
        "isFreelancer": {
          "type": "boolean",
          "description": "Whether the merchant operates in freelance capacity."
        },
        "verificationStatus": {
          "type": "string",
          "enum": ["PENDING", "VERIFIED", "REJECTED", "DISPUTED"],
          "description": "Verification compliance state."
        },
        "verificationOcrLog": {
          "type": "string",
          "description": "Compliance OCR raw text trace."
        },
        "isDisputed": {
          "type": "boolean",
          "description": "Claim dispute toggle state."
        },
        "disputeReason": {
          "type": "string",
          "description": "Argument provided by debtor."
        },
        "isMouthToMouth": {
          "type": "boolean",
          "description": "Verbal handshake agreement category."
        },
        "handshakeStatus": {
          "type": "string",
          "enum": ["PENDING_CONFIRMATION", "CONFIRMED", "DECLINED"],
          "description": "Handshake trade authorization confirmation state."
        }
      },
      "required": ["ownerId", "name", "email", "phone", "amount", "currency", "status", "createdAt"]
    },
    "LogEntry": {
      "title": "LogEntry",
      "description": "A single communication event or status change logged for the debtor.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["email", "sms", "call", "status_change"],
          "description": "Communication channel or state event."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the log entry occurred."
        },
        "text": {
          "type": "string",
          "description": "Detail description of communication text or event."
        },
        "status": {
          "type": "string",
          "enum": ["delivered", "failed", "read", "completed"],
          "description": "Event processing result."
        }
      },
      "required": ["type", "timestamp", "text", "status"]
    },
    "InvoiceLineItem": {
      "title": "InvoiceLineItem",
      "description": "A single item or service billed within an invoice.",
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "quantity": { "type": "number" },
        "unitPrice": { "type": "number" },
        "total": { "type": "number" }
      },
      "required": ["description", "quantity", "unitPrice", "total"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "A professional invoice generated for freelancer or agency services.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "issueDate": { "type": "string" },
        "dueDate": { "type": "string" },
        "status": { "type": "string", "enum": ["DRAFT", "SENT", "PAID", "OVERDUE"] },
        "currency": { "type": "string" },
        "businessName": { "type": "string" },
        "businessAddress": { "type": "string" },
        "businessEmail": { "type": "string" },
        "businessPhone": { "type": "string" },
        "logoUrl": { "type": "string" },
        "clientName": { "type": "string" },
        "clientAddress": { "type": "string" },
        "clientEmail": { "type": "string" },
        "clientPhone": { "type": "string" },
        "subtotal": { "type": "number" },
        "taxRate": { "type": "number" },
        "taxAmount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "bankName": { "type": "string" },
        "accountName": { "type": "string" },
        "accountNumber": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": [
        "id",
        "ownerId",
        "invoiceNumber",
        "issueDate",
        "dueDate",
        "status",
        "currency",
        "businessName",
        "clientName",
        "subtotal",
        "taxRate",
        "taxAmount",
        "totalAmount",
        "createdAt"
      ]
    },
    "WaitlistEntry": {
      "title": "WaitlistEntry",
      "description": "Represents an entry on the product's public launch waitlist.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "userType": { "type": "string" },
        "debtCurrency": { "type": "string" },
        "debtAmount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "createdAt"]
    },
    "Business": {
      "title": "Business",
      "description": "Represents a verified SME merchant profile listed for discovery.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessName": { "type": "string" },
        "category": { "type": "string" },
        "location": { "type": "string" },
        "market": { "type": "string" },
        "city": { "type": "string" },
        "description": { "type": "string" },
        "priceRange": { "type": "string" },
        "verified": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "fastResponder": { "type": "boolean" },
        "rating": { "type": "number" },
        "telegramBotUrl": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "businessName", "category", "location", "status", "verified"]
    },
    "Stats": {
      "title": "Stats",
      "description": "Global statistics and social proof metrics.",
      "type": "object",
      "properties": {
        "totalUsersLinked": {
          "type": "number",
          "description": "Cumulative total of users linked to local merchants via search."
        },
        "lastUpdated": {
          "type": "string",
          "description": "ISO timestamp of last metric update."
        }
      },
      "required": ["totalUsersLinked"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores credentials, settings, subscriber tiers and escrow clearance parameters for merchants."
    },
    "/debtors/{debtorId}": {
      "schema": "Debtor",
      "description": "Core payment folders managed by standard merchants."
    },
    "/debtors/{debtorId}/history/{logId}": {
      "schema": "LogEntry",
      "description": "Rich telemetry log streams documenting system emails, robocalls and SMS pings."
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Collection storing professional agency and freelancer invoices."
    },
    "/waitlist/{entryId}": {
      "schema": "WaitlistEntry",
      "description": "Collection storing waitlist requests from prospective merchants."
    },
    "/businesses/{businessId}": {
      "schema": "Business",
      "description": "Collection storing verified active local SME business profiles."
    },
    "/stats/{statId}": {
      "schema": "Stats",
      "description": "Global system counters and social proof metrics."
    }
  }
}
